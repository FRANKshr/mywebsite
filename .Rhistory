#| label: setup
set.seed(3201)
A <- matrix(c(
2,  0,  1,
0,  3, -1,
1, -1,  4
), nrow = 3, byrow = TRUE)
B <- matrix(c(
1,  2,  0,
2,  5, -3,
0, -3,  6
), nrow = 3, byrow = TRUE)
isSymmetric(A)
isSymmetric(B)
A + B
3 * A - 2 * B
A %*% B
B %*% A
A * B
#| label: setup
set.seed(3201)
X <- matrix(c(
1, 4,
2, 5,
3, 6
), nrow = 3, byrow = TRUE)
t(X)
dim(t(X))
t(X) %*% X
dim(t(X) %*% X)
X %*% t(X)
dim(X %*% t(X))
v <- matrix(c(1, -1, 2), ncol = 1)
t(v) %*% v
dim(t(v) %*% v)
v %*% t(v)
dim(v %*% t(v))
t(A %*% B)
t(B) %*% t(A)
isTRUE(all.equal(t(A %*% B), t(B) %*% t(A)))
A <- matrix(c(
4, 2,
3, 3
), nrow = 2, byrow = TRUE)
solve(A)
#| error: true
S <- matrix(c(
1, 0, 1,
0, 1, 1,
1, 1, 2
), nrow = 3, byrow = TRUE)
solve(S)
x1 <- c(1, 2, 1)
x2 <- c(0, 1, 1)
x3 <- c(2, 5, 3)
M <- cbind(x1, x2, x3)
qr(M)$rank
x3[3] <- 4
M_new <- cbind(x1, x2, x3)
qr(M_new)$rank
x3[3] <- 4
M_new <- cbind(x1, x2, x3)
qr(M_new)$rank
A <- matrix(c(
2, 1,
1, 2
), nrow = 2, byrow = TRUE)
B <- matrix(c(
1, 1,
1, 1
), nrow = 2, byrow = TRUE)
eigen(A)$values
eigen(B)$values
A <- matrix(c(
0.5, 0.5,
0.5, 0.5
), nrow = 2, byrow = TRUE)
A %*% A
isTRUE(all.equal(A %*% A, A))
set.seed(3201)
mu <- c(2, 0, -1)
Sigma <- matrix(c(
4,  1,  0,
1,  2, -1,
0, -1,  3
), nrow = 3, byrow = TRUE)
A <- matrix(c(
1, 1,  0,
0, 1, -1
), nrow = 2, byrow = TRUE)
b <- c(5, -2)
a <- c(1, -1, 2)
X_sim <- MASS::mvrnorm(
n = 100000,
mu = mu,
Sigma = Sigma
)
Y_sim <- sweep(X_sim %*% t(A), 2, b, FUN = "+")
Z_sim <- X_sim %*% a
round(colMeans(Y_sim), 2)
round(cov(Y_sim), 2)
round(cov(Z_sim), 2)
X1 <- X_sim[, 1]
X3 <- X_sim[, 3]
plot(
X3, X1,
xlab = "X3",
ylab = "X1",
main = "X1 against X3",
pch = 16,
cex = 0.3,
col = rgb(0, 0, 1, alpha = 0.05)
)
round(cor(X1, X3), 2)
a <- c(3, -2, 1)
S <- matrix(c(
2, 1, 0,
1, 3, 1,
0, 1, 2
), nrow = 3, byrow = TRUE)
x0 <- c(1, 0, -1)
f_linear <- function(x) {
sum(a * x)
}
f_quadratic <- function(x) {
as.numeric(t(x) %*% S %*% x)
}
round(numDeriv::grad(f_linear, x0), 2)
