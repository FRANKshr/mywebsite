install.packages("numDeriv", repos = "https://cloud.r-project.org")
a <- c(3, -2, 1)
S <- matrix(c(
2, 1, 0,
1, 3, 1,
0, 1, 2
), nrow = 3, byrow = TRUE)
x0 <- c(1, 0, -1)
f_linear <- function(x) {
sum(a * x)
}
f_quadratic <- function(x) {
as.numeric(t(x) %*% S %*% x)
}
round(numDeriv::grad(f_linear, x0), 2)
round(numDeriv::grad(f_quadratic, x0), 2)
